# Dependencies
node_modules/
.npm/

# Build output
dist/
dist-ssr/
*.local

# Local datastore. The JSON file is regenerated by `npm run sync` and can be
# several MB — it is derived data, not source, and must not be committed.
data/
!data/.gitkeep

# Secrets. `.env.example` IS committed; `.env` never is.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test + tooling caches
coverage/
.nyc_output/
.vite/
.eslintcache
