# ---------------------------------------------------------------------------
# HackRadar — copy to .env and fill in the values you need.
# NOTHING here is required for the app to run. With an empty .env HackRadar uses
# a local JSON store, built-in email/password auth, rule-based project ideas, and
# real data from Devpost, Unstop, Devfolio and HackerEarth.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=8787

# Comma-separated allowed browser origins. Use "*" only for local experiments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the JSON store writes hackradar-db.json (local store driver only).
DATA_DIR=./data

# Signs HackRadar's own session cookies. REQUIRED in production for the built-in
# auth. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave blank and Supabase Auth will be used instead (SUPABASE_ANON_KEY below).
JWT_SECRET=
SESSION_TTL_DAYS=30

# --- Datastore --------------------------------------------------------------
# "auto"    -> Supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set,
#              otherwise the bundled local JSON store.
# "supabase" -> require Supabase (startup fails loudly if credentials are missing).
# "local"     -> always use the JSON store (single-process only).
STORE_DRIVER=auto

# --- Supabase ---------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Project Settings -> API -> copy Project URL and the anon public key.
# 3. Project Settings -> API -> copy the service_role key (server only!).
# 4. Run the migrations in supabase/migrations/ in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NEVER expose this to the browser. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Synchronization schedule ------------------------------------------------
# node-cron expression used by the in-process scheduler. Also mirrored in
# vercel.json / your platform's cron config if you deploy to a serverless host.
SYNC_CRON=*/30 * * * *
# Fetch each source immediately on server start.
SYNC_RUN_ON_BOOT=true
# Shared secret for GET/POST /api/cron/sync. REQUIRED in production so random
# internet traffic cannot trigger a sync. Leave blank locally.
CRON_SECRET=
# Per-source poll intervals in minutes. Each source is only re-fetched once this
# much time has passed since its last success. These are deliberately gentle.
SYNC_INTERVAL_DEVPOST=45
SYNC_INTERVAL_UNSTOP=90
SYNC_INTERVAL_DEVFOLIO=240
SYNC_INTERVAL_HACKEREARTH=180
SYNC_INTERVAL_KAGGLE=720
# Maximum listing pages fetched per source per run (safety valve).
SYNC_MAX_PAGES_DEVPOST=8
SYNC_MAX_PAGES_UNSTOP=12
SYNC_MAX_PAGES_DEVFOLIO=3
SYNC_MAX_PAGES_HACKEREARTH=2
SYNC_MAX_PAGES_KAGGLE=1
# How many event detail pages to enrich (fetch full overview/judging text) per run.
SYNC_ENRICHMENT_BUDGET=40
SOURCE_TIMEOUT_MS=25000
# Identify your crawler honestly. Some sources are easier on a named client.
# SOURCE_USER_AGENT=HackRadarBot/1.0 (+https://your-site.example)

# --- Optional: Kaggle -------------------------------------------------------
# Without these, the Kaggle source is disabled (its API returns 401).
# Create a key at https://www.kaggle.com/settings/account
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Optional: AI project ideas --------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint (OpenAI, OpenRouter, Groq,
# Together, Azure, or a local Ollama). The key is only ever read by the server.
# With this blank, HackRadar uses its deterministic rule-based generator, which
# derives suggestions from each event's real published themes and technologies.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_MAX_IDEAS=6

# --- Optional: Web Push -----------------------------------------------------
# Generate a VAPID key pair with:  npx web-push generate-vapid-keys
# Both values are required; without them the browser push toggle is disabled and
# the UI says so.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.example

# --- Optional: Email -------------------------------------------------------
# EMAIL_PROVIDER=smtp     -> uses SMTP_* below
# EMAIL_PROVIDER=resend   -> uses RESEND_API_KEY
# Without one of these, email subscriptions are saved but nothing is delivered,
# and the UI reports email as unavailable.
EMAIL_PROVIDER=
EMAIL_FROM=HackRadar <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- Notifications ----------------------------------------------------------
# Hard cap on in-app alerts a single user can receive from one sync run.
NOTIFY_MAX_PER_USER_RUN=12
# "Closing soon" window in days.
NOTIFY_CLOSING_SOON_DAYS=5
# Default quiet hours (UTC, 24h clock). Users can override these.
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=600
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=120
RATE_LIMIT_AI=12

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Vite (frontend, optional) ---------------------------------------------
# Only needed when the API is not on http://localhost:8787 during development.
# VITE_API_PROXY_TARGET=http://localhost:8787
